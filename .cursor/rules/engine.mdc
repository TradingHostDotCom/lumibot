### Multiple Strategies

Lumibot supports running multiple strategies in one Trader:

```python
strategy_a = MomentumStrategy(broker=broker, parameters={'lookback': 20})
strategy_b = MeanReversionStrategy(broker=broker, parameters={'threshold': 2.0})

trader = Trader()
trader.add_strategy(strategy_a)
trader.add_strategy(strategy_b)
trader.run_all()
```

Each strategy gets its own `on_trading_iteration()` cycle. Be careful with position conflicts — two strategies should trade different symbols or coordinate via SQLite.

## Recipes

### Creating a Strategy Class

Every Lumibot strategy extends `Strategy` and implements `on_trading_iteration()`:

```python
from lumibot.strategies import Strategy

class MyStrategy(Strategy):
    parameters = {
        'symbol': 'SPY',
        'quantity': 10,
    }

    def initialize(self):
        self.sleeptime = '1D'  # Run once per day

    def on_trading_iteration(self):
        symbol = self.parameters['symbol']
        quantity = self.parameters['quantity']

        current_price = self.get_last_price(symbol)
        log('info', 'Iteration', symbol=symbol, price=current_price)
```

`self.sleeptime` controls how often `on_trading_iteration()` runs. Values: `'1M'` (1 minute), `'5M'`, `'15M'`, `'1H'`, `'1D'`.

### Implementing Momentum (Buy Top N)

```python
class MomentumStrategy(Strategy):
    parameters = {
        'symbols': ['AAPL', 'MSFT', 'GOOGL', 'AMZN', 'NVDA', 'META', 'TSLA', 'JPM', 'V', 'UNH'],
        'top_n': 3,
        'lookback_days': 30,
    }

    def initialize(self):
        self.sleeptime = '1D'

    def on_trading_iteration(self):
        symbols = self.parameters['symbols']
        top_n = self.parameters['top_n']

        returns = {}
        for symbol in symbols:
            bars = self.get_historical_prices(symbol, self.parameters['lookback_days'], 'day')
            if bars and len(bars.df) >= 2:
                pct = (bars.df['close'].iloc[-1] / bars.df['close'].iloc[0]) - 1
                returns[symbol] = pct

        winners = sorted(returns, key=returns.get, reverse=True)[:top_n]

        current_positions = {p.symbol: p for p in self.get_positions()}
        for symbol, pos in current_positions.items():
            if symbol not in winners:
                self.sell_all(symbol)

        cash = self.get_cash()
        per_stock = cash / max(len(winners), 1)
        for symbol in winners:
            if symbol not in current_positions:
                price = self.get_last_price(symbol)
                if price and price > 0:
                    qty = int(per_stock / price)
                    if qty > 0:
                        order = self.create_order(symbol, qty, 'buy')
                        self.submit_order(order)
```

### Implementing Mean Reversion

```python
class MeanReversionStrategy(Strategy):
    parameters = {
        'symbol': 'SPY',
        'lookback': 20,
        'entry_std': 2.0,
        'exit_std': 0.5,
        'max_pct_portfolio': 0.25,
    }

    def initialize(self):
        self.sleeptime = '1D'

    def on_trading_iteration(self):
        symbol = self.parameters['symbol']
        bars = self.get_historical_prices(symbol, self.parameters['lookback'] + 5, 'day')
        if not bars or len(bars.df) < self.parameters['lookback']:
            return

        closes = bars.df['close'].tail(self.parameters['lookback'])
        mean = closes.mean()
        std = closes.std()
        current_price = self.get_last_price(symbol)
        z_score = (current_price - mean) / std if std > 0 else 0

        position = self.get_position(symbol)

        if z_score < -self.parameters['entry_std'] and not position:
            cash = self.get_cash()
            max_spend = self.get_portfolio_value() * self.parameters['max_pct_portfolio']
            spend = min(cash, max_spend)
            qty = int(spend / current_price)
            if qty > 0:
                order = self.create_order(symbol, qty, 'buy')
                self.submit_order(order)

        elif position and z_score > -self.parameters['exit_std']:
            self.sell_all(symbol)
```

### Adding a Custom Indicator

Use pandas for technical indicators. Lumibot's `get_historical_prices()` returns a `Bars` object with a `.df` DataFrame:

```python
def calculate_rsi(self, symbol, period=14):
    bars = self.get_historical_prices(symbol, period + 10, 'day')
    if not bars or len(bars.df) < period:
        return None
    delta = bars.df['close'].diff()
    gain = delta.where(delta > 0, 0).rolling(window=period).mean()
    loss = (-delta.where(delta < 0, 0)).rolling(window=period).mean()
    rs = gain / loss
    rsi = 100 - (100 / (1 + rs))
    return rsi.iloc[-1]
```

